<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Allows the app to request live weather data from WeatherAPI -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.WeatherTrio">

        <!-- MainActivity contains the main three-tab app interface -->
        <activity
            android:name=".view.MainActivity"
            android:exported="false" />

        <!-- SplashActivity opens first when the app launches -->
        <activity
            android:name="view.SplashActivity"
            android:exported="true"
            android:noHistory="true"
            android:theme="@style/Theme.WeatherTrio.Splash">
 
            <!-- Makes SplashActivity the launcher activity -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

    </application>

</manifest>