<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Allows WeatherTrio to access live weather,
         city search, and Firebase services over the internet. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Android 11+ limits which installed apps can be discovered
        through PackageManager checks such as resolveActivity().

        WeatherTrio checks for an email app and a browser before
        launching those system intents, so declare both here.
    -->
    <queries>

        <!-- Allows Send Feedback to discover email apps. -->
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>

        <!-- Allows View on GitHub to discover web browsers. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>

    </queries>

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.WeatherTrio">

        <!-- MainActivity contains the main Search, Saved,
             and Settings sections of the app. -->
        <activity
            android:name=".view.MainActivity"
            android:exported="false" />

        <!-- Login screen for existing Firebase users. -->
        <activity
            android:name=".view.LoginActivity"
            android:exported="false" />

        <!-- Registration screen for new Firebase users. -->
        <activity
            android:name=".view.RegisterActivity"
            android:exported="false" />

        <!-- SplashActivity remains the first screen shown
             when WeatherTrio launches. -->
        <activity
            android:name=".view.SplashActivity"
            android:exported="true"
            android:noHistory="true"
            android:theme="@style/Theme.WeatherTrio.Splash">

            <!-- Makes SplashActivity the launcher activity. -->
            <intent-filter>

                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />

            </intent-filter>

        </activity>

    </application>

</manifest>