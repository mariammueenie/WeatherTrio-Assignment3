<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_main"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Temporary empty-state icon for Saved screen -->
    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:contentDescription="@string/saved_empty_icon_description"
        android:src="@android:drawable/btn_star_big_off"
        android:tint="@color/secondary" />

    <!-- Explains no cities have been saved yet -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/saved_empty_message"
        android:textAppearance="@style/TextAppearance.WeatherTrio.Body"
        android:textSize="18sp" />

</LinearLayout>