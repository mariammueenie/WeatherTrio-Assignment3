<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_main"
    android:orientation="vertical">

    <!--
        Keeps the existing Saved screen toolbar.
    -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarSaved"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:title="@string/saved_title"
        app:titleTextColor="@color/text_primary" />

    <!--
        Holds either the saved-location list
        or the existing empty-state message.
    -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!--
            Displays SavedLocation objects returned from Firestore.
            It starts hidden until the app receives at least one location.
        -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerSavedLocations"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="16dp"
            android:visibility="gone" />

        <!--
            Existing empty state.
            This stays visible while the user has no saved locations.
        -->
        <LinearLayout
            android:id="@+id/layoutSavedEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <!--
                Existing Saved-screen empty-state icon.
            -->
            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@string/saved_empty_icon_description"
                android:src="@drawable/ic_saved_empty" />

            <!--
                Explains that there are currently no saved cities.
            -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/saved_empty_message"
                android:textAppearance="@style/TextAppearance.WeatherTrio.Body"
                android:textSize="18sp" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>