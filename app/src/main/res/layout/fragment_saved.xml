<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_main"
    android:orientation="vertical">

    <!--
        Displays required Saved screen title.
        Using same toolbar style keeps all main screens consistent.
    -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarSaved"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:title="@string/saved_title"
        app:titleTextColor="@color/text_primary" />

    <!--
        Centres required empty-state content below the toolbar.
        This screen remains simple because saved cities are added later.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <!--
            Shows an icon so empty state is visually clear.
            A custom vector icon will replace this temporary drawable later.
        -->
        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="@string/saved_empty_icon_description"
            android:src="@drawable/ic_saved_empty" />

        <!-- Explains why Saved screen currently has no content -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/saved_empty_message"
            android:textAppearance="@style/TextAppearance.WeatherTrio.Body"
            android:textSize="18sp" />

    </LinearLayout>

</LinearLayout>