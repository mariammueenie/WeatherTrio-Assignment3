<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_main"
    android:orientation="vertical">

    <!--
        Keeps the same Search toolbar used in Assignment 1.
    -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:title="@string/search_title"
        app:titleTextColor="@color/text_primary" />

    <!--
        Keeps the existing search field from Assignment 1.
        The Assignment 2 rubric does not require filtering,
        so it remains part of the established design.
    -->
    <EditText
        android:id="@+id/editSearchCity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:hint="@string/search_hint"
        android:inputType="text"
        android:maxLines="1"
        android:padding="14dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary" />

    <!--
        Assignment 2 requires the locations to be displayed
        using RecyclerView rather than hardcoded cards.
    -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerLocations"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:layout_weight="1"
        android:clipToPadding="false" />

</LinearLayout>