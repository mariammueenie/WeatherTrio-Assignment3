<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_main"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Displays app name in centre of splash screen -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textAppearance="@style/TextAppearance.WeatherTrio.Headline"
        android:textSize="36sp" />

    <!-- subtitle shows while the app is opening -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/splash_subtitle"
        android:textAppearance="@style/TextAppearance.WeatherTrio.Body" />

</LinearLayout>