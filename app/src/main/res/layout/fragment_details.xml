<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_main"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/textCityName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/details_no_city"
        android:textAppearance="@style/TextAppearance.WeatherTrio.Headline" />

    <TextView
        android:id="@+id/textWeatherSummary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/details_select_city"
        android:textAppearance="@style/TextAppearance.WeatherTrio.Body" />

</LinearLayout>