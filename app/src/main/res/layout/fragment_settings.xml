<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_main"
    android:orientation="vertical">

    <!--
        Displays required Settings screen title.
        Using the same toolbar style keeps all three main screens consistent.
    -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:title="@string/settings_title"
        app:titleTextColor="@color/text_primary" />

    <!--
        Holds Settings screen content below the toolbar.
        The current buttons will be replaced with the required settings options later.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Brief explanation of what Settings screen contains -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="@string/settings_subtitle"
            android:textAppearance="@style/TextAppearance.WeatherTrio.Body" />

        <!--
            Temporary Wi-Fi button.
            will be replaced later with the required Send Feedback option.
        -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonWifiSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_wifi" />

        <!--
            Temporary location button.
            will be replaced later with the required GitHub or Website option.
        -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonLocationSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_location" />

        <!--
            Temporary app-settings button.
            will be replaced later with the required Share App option.
        -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonAppSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_app" />

    </LinearLayout>

</LinearLayout>