<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_main"
    android:orientation="vertical">

    <!--
        Displays the Settings screen title.
        This keeps the screen consistent with Search and Saved.
    -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:title="@string/settings_title"
        app:titleTextColor="@color/text_primary" />

    <!-- Holds all Settings content below the toolbar. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="24dp">

        <!--
            Shows which Firebase user is currently signed in.
        -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Signed in as"
            android:textAppearance="@style/TextAppearance.WeatherTrio.Body"
            android:textStyle="bold" />

        <!--
            SettingsFragment will place the authenticated
            Firebase user's email address here.
        -->
        <TextView
            android:id="@+id/textSignedInEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="user@example.com"
            android:textAppearance="@style/TextAppearance.WeatherTrio.Body" />

        <!--
            Shows the app version.
            The real version is inserted from BuildConfig in Java.
        -->
        <TextView
            android:id="@+id/textAppVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/settings_version_placeholder"
            android:textAppearance="@style/TextAppearance.WeatherTrio.Body" />

        <!-- Opens the user's email app with feedback information pre-filled. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonSendFeedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/settings_send_feedback"
            app:icon="@drawable/ic_feedback"
            app:iconGravity="textStart"
            app:iconPadding="12dp" />

        <!-- Opens the project website or GitHub page. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonViewWebsite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_view_website"
            app:icon="@drawable/ic_website"
            app:iconGravity="textStart"
            app:iconPadding="12dp" />

        <!-- Opens the Android share sheet. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonShareApp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_share_app"
            app:icon="@drawable/ic_share"
            app:iconGravity="textStart"
            app:iconPadding="12dp" />

        <!--
            Signs the current Firebase user out.
            The Java code will connect this button in the next step.
        -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonSignOut"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Sign Out" />

    </LinearLayout>

</LinearLayout>