<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_main"
    android:orientation="vertical">

    <!--
        Displays the required Settings screen title.
        This keeps the screen consistent with Search and Saved.
    -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:title="@string/settings_title"
        app:titleTextColor="@color/text_primary" />

    <!-- Holds the settings content below the toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="24dp">

        <!--
            Shows the app version.
            The actual version value will be inserted from BuildConfig in Java.
        -->
        <TextView
            android:id="@+id/textAppVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_version_placeholder"
            android:textAppearance="@style/TextAppearance.WeatherTrio.Body" />

        <!--
            Opens the user's email app with feedback information pre-filled.
            The icon appears before the label as required.
        -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonSendFeedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/settings_send_feedback"
            app:icon="@drawable/ic_feedback"
            app:iconGravity="textStart"
            app:iconPadding="12dp" />

        <!--
            Opens a GitHub page or website in the user's browser.
            The browser Intent will be connected in SettingsFragment.
        -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonViewWebsite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_view_website"
            app:icon="@drawable/ic_website"
            app:iconGravity="textStart"
            app:iconPadding="12dp" />

        <!--
            Opens the Android share sheet.
            This lets the user share a short message about WeatherTrio.
        -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonShareApp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_share_app"
            app:icon="@drawable/ic_share"
            app:iconGravity="textStart"
            app:iconPadding="12dp" />

    </LinearLayout>

</LinearLayout>